{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "odin",
  "main": "../../proxy/cloudflare-worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../web/dist",
    "run_worker_first": ["/relay/*", "/api/*", "/gh/*"]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "allfather.dev", "custom_domain": true, "zone_name": "allfather.dev" },
    { "pattern": "www.allfather.dev", "custom_domain": true, "zone_name": "allfather.dev" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "odin", "database_id": "61e04158-1354-4853-9c02-f8bc0cf48069" }
  ],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "ROUTE_PREFIX": "/relay",
    "ALLOWED_ORIGINS": "https://allfather.dev,https://www.allfather.dev"
  }
}
