{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "odin",
  "main": "../../proxy/cloudflare-worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../web/dist",
    "run_worker_first": ["/relay/*"]
  },
  "workers_dev": true,
  "routes": [{ "pattern": "allfather.dev", "custom_domain": true, "zone_name": "allfather.dev" }],
  "vars": {
    "ROUTE_PREFIX": "/relay",
    "ALLOWED_ORIGINS": "https://allfather.dev"
  }
}
