{
  "name": "odin-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Odin: find the code behind any bug report, in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
